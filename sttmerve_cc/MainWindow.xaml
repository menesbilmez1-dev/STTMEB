<Window x:Class="sttmerve_cc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:sttmerve_cc"
        xmlns:helpers="clr-namespace:sttmerve_cc.Helpers"
        mc:Ignorable="d"
        Title="Komuta Merkezi - Excel Yöneticisi" Height="700" Width="1200" Background="#F0F0F0">
    <Window.Resources>
        <helpers:BooleanToColorConverter x:Key="BooleanToColorConverter"/>
        <helpers:BooleanToStatusConverter x:Key="BooleanToStatusConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Controls -->
            <RowDefinition Height="*"/>    <!-- Tabs (DataGrid & Logs) -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15,10">
            <TextBlock Text="EXCEL KOMUTA MERKEZİ" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Border>

        <!-- Controls Panel -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10" Background="White">
            <!-- Excel File Selection -->
            <StackPanel Margin="5" VerticalAlignment="Center">
                <TextBlock Text="Excel Dosya Yolu:" FontWeight="Bold" Margin="0,0,0,5"/>
                <DockPanel>
                    <Button Content="Gözat..." Command="{Binding LoadExcelCommand}" DockPanel.Dock="Right" Width="75" Margin="5,0,0,0"/>
                    <TextBox Width="350" Text="{Binding ExcelFilePath, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                </DockPanel>
            </StackPanel>

            <Button Content="Yükle" Command="{Binding LoadExcelFromCurrentPathCommand}" Margin="10,15,10,5" Padding="10,5" Width="60" Background="#2ECC71" Foreground="White"/>
            <Button Content="Excel'e Kaydet" Command="{Binding SaveToExcelCommand}" Margin="5,15,10,5" Padding="10,5" Width="100" Background="#3498DB" Foreground="White"/>
            <Button Content="Yapılandırmayı Excel'den Kaydet" Command="{Binding SaveConfigFromExcelCommand}" Margin="5,15,10,5" Padding="10,5" Width="180" Background="#E67E22" Foreground="White"/>
            <Button Content="Şemayı Excel ile Senkronize Et" Command="{Binding SyncWithExcelCommand}" Margin="5,15,10,5" Padding="10,5" Width="200" Background="#9B59B6" Foreground="White"/>



            <Separator Width="2" Margin="10,0" Background="#DDD"/>

            <!-- Sheet Selection -->
            <StackPanel Margin="5" VerticalAlignment="Center">
                <TextBlock Text="Hedef Sayfa:" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox Width="150" ItemsSource="{Binding Sheets}" SelectedItem="{Binding SelectedSheet}" DisplayMemberPath="Name"/>
            </StackPanel>

            <Separator Width="2" Margin="10,0" Background="#DDD"/>

            <!-- Server Controls -->
            <StackPanel Orientation="Horizontal" Margin="5" VerticalAlignment="Center">
                <Button Content="Sunucuyu Başlat" Command="{Binding StartServerCommand}" Margin="0,0,10,0" Padding="10,5" Width="100" Background="#27AE60" Foreground="White"/>
                <Button Content="Sunucuyu Durdur" Command="{Binding StopServerCommand}" Padding="10,5" Width="100" Background="#C0392B" Foreground="White"/>
            </StackPanel>
        </StackPanel>

        <!-- Main Content Tabs -->
        <TabControl Grid.Row="2" Margin="10,0,10,10">
            <TabItem Header="Excel Verileri">
                <DataGrid ItemsSource="{Binding SheetDataTable}" 
                          AutoGenerateColumns="True" 
                          IsReadOnly="False" 
                          Margin="0"
                          VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Auto"
                          Background="White"/>
            </TabItem>
            <TabItem Header="Sistem Günlükleri">
                <Grid Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Sistem Günlükleri ve Faaliyetler" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Logs}" Background="Black" Foreground="#00FF00" FontFamily="Consolas" FontSize="12" BorderThickness="0"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Height="30">
            <!-- 1. Server Running Indicator -->
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Margin="5,0" Fill="{Binding IsServerRunning, Converter={StaticResource BooleanToColorConverter}}"/>
                    <TextBlock Text="Sunucu Durumu: "/>
                    <TextBlock Text="{Binding IsServerRunning, Converter={StaticResource BooleanToStatusConverter}}"/>
                </StackPanel>
            </StatusBarItem>

            <Separator/>

            <!-- 2. General Status Message -->
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>

            <Separator/>

            <!-- 3. Server URL (IP Address) -->
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Sunucu URL: " FontWeight="Bold" Margin="5,0,2,0"/>
                    <TextBlock Text="{Binding ServerUrl}" Foreground="#27AE60" FontWeight="Bold"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>
